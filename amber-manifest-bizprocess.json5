{
  // Amber manifest for Solstice Business Process Agent (AgentBeats Phase 2 Sprint 1)
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      google_api_key:       { type: "string", secret: true },
      agentbeats_llm_model: { type: "string" },
    },
    required: ["google_api_key"],
    additionalProperties: false,
  },

  slots: {
    proxy: { kind: "a2a", optional: true },
  },

  program: {
    image: "ghcr.io/solasticeaistudio/solstice-agentbeats:bizprocess-v8",
    entrypoint: "python /home/agent/src/server_bizprocess.py --host 0.0.0.0 --port 9009",
    env: {
      GOOGLE_API_KEY:       "${config.google_api_key}",
      AGENTBEATS_LLM_MODEL: "${config.agentbeats_llm_model}",
      PYTHONPATH:           "/home/agent/src",
      PYTHONUNBUFFERED:     "1",
    },
    network: {
      endpoints: [{ name: "a2a_endpoint", port: 9009 }],
    },
  },

  provides: { a2a: { kind: "a2a", endpoint: "a2a_endpoint" } },
  exports:  { a2a: "a2a" },
}
