# Solstice Business Process Agent — AgentBeats Phase 2
# Standalone build (litellm fallback when Solstice stack unavailable)

FROM python:3.11-slim

RUN adduser --disabled-password agent
USER agent
WORKDIR /home/agent

COPY --chown=agent requirements.txt ./
RUN pip install --user --no-cache-dir -r requirements.txt

COPY --chown=agent src src

ENV PYTHONPATH=/home/agent/src
ENV PATH=/home/agent/.local/bin:$PATH

ENTRYPOINT ["python", "src/server_bizprocess.py"]
CMD ["--host", "0.0.0.0", "--port", "9009"]
EXPOSE 9009
