# Solstice Business Process Agent — AgentBeats Phase 2

FROM ghcr.io/astral-sh/uv:python3.11-bookworm

ENV PYTHONUNBUFFERED=1
ENV UV_HTTP_TIMEOUT=300

WORKDIR /home/agent

COPY pyproject.toml ./
RUN uv lock && uv sync --no-dev

COPY src src
ENV PYTHONPATH=/home/agent/src
ENV PATH="/home/agent/.venv/bin:$PATH"

EXPOSE 9009
