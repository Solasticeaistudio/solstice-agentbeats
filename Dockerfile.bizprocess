# Solstice Business Process Agent — AgentBeats Phase 2
# Build from Solstice-EIM root:
#   docker build -f agentbeats/Dockerfile.bizprocess -t solstice-bizprocess-agent .

FROM ghcr.io/astral-sh/uv:python3.11-bookworm

ENV UV_HTTP_TIMEOUT=300

RUN adduser --disabled-password agent
USER agent
WORKDIR /home/agent

# Copy agentbeats project files
COPY --chown=agent agentbeats/pyproject.toml agentbeats/README.md* ./
COPY --chown=agent agentbeats/src src

# Copy selective Solstice-EIM modules that agents import
COPY --chown=agent services/llm_service.py solstice/services/llm_service.py
COPY --chown=agent services/retrieval_service.py solstice/services/retrieval_service.py
COPY --chown=agent services/agent_orchestrator.py solstice/services/agent_orchestrator.py
COPY --chown=agent services/embedding_service.py solstice/services/embedding_service.py
COPY --chown=agent agents/plutus.py solstice/agents/plutus.py
COPY --chown=agent config/ solstice/config/
COPY --chown=agent utils/ solstice/utils/

# Create __init__.py files for Solstice packages
RUN touch solstice/__init__.py solstice/services/__init__.py solstice/agents/__init__.py

ENV SOLSTICE_ROOT=/home/agent/solstice
ENV PYTHONPATH=/home/agent/src:/home/agent

RUN --mount=type=cache,target=/home/agent/.cache/uv,uid=1000 \
    uv sync --locked --no-dev 2>/dev/null || uv sync --no-dev

ENTRYPOINT ["uv", "run", "src/server_bizprocess.py"]
CMD ["--host", "0.0.0.0", "--port", "9009"]
EXPOSE 9009
