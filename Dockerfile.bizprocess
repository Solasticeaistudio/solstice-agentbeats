# Solstice Business Process Agent — AgentBeats Phase 2
FROM ghcr.io/astral-sh/uv:python3.11-bookworm

ENV PYTHONUNBUFFERED=1

RUN adduser agent
USER agent
WORKDIR /home/agent

COPY --chown=agent:agent pyproject.toml uv.lock ./
COPY --chown=agent:agent src src

RUN uv sync --locked --no-dev

EXPOSE 9009
CMD ["uv", "run", "python", "/home/agent/src/server_bizprocess.py", "--host", "0.0.0.0", "--port", "9009"]
