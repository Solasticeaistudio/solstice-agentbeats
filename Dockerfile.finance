# Solstice Finance Agent — AgentBeats Phase 2

FROM ghcr.io/astral-sh/uv:python3.11-bookworm

ENV PYTHONUNBUFFERED=1
ENV UV_HTTP_TIMEOUT=300

WORKDIR /home/agent

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev

COPY src src
ENV PYTHONPATH=/home/agent/src

ENTRYPOINT ["/home/agent/.venv/bin/python", "/home/agent/src/server_finance.py", "--host", "0.0.0.0", "--port", "9009"]
EXPOSE 9009
